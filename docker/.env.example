# Default ports match Docker container ports.
# On this Windows machine, 8848 and 9300 are in excluded TCP ranges,
# and host Redis/RabbitMQ services may already occupy 6379/5672.
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6380
RABBITMQ_HOST_PORT=5673
RABBITMQ_MANAGEMENT_HOST_PORT=15672
NACOS_HOST_PORT=8951
# Nacos 2.x clients expect the gRPC port to be HTTP port + 1000.
NACOS_GRPC_HOST_PORT=9951
ELASTICSEARCH_HTTP_PORT=9200
ELASTICSEARCH_TRANSPORT_PORT=9459
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
XXL_JOB_ADMIN_PORT=8088
